# docker-compose 환경변수 (루트). 필요시 .env 로 복사해서 값만 수정하세요.
DB_USERNAME=root
DB_PASSWORD=1234
DB_DATABASE=online_course
DB_SYNCHRONIZE=true
JWT_SECRET=jwt_secret_key_p2_online_course_2024
# Toss Payments 테스트 시크릿 키 (실제 운영시 반드시 변경)
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# 이메일(SMTP) — 미설정 시 stream transport(드라이런)으로 동작.
# Gmail은 앱 비밀번호(2FA 필요), 운영은 SES/Mailgun/SendGrid 권장.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@online-course.local

# Observability
APP_VERSION=dev
